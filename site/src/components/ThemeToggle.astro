---
/**
 * Switches between the dark (default) and light themes, as a single icon: a
 * sun in dark mode (switch to light), a moon in light mode (switch to dark).
 * The choice is kept in localStorage; BaseLayout applies it before the page
 * paints, so there is no flash. CSS picks the icon and its label from
 * data-theme, so both are right before any script runs.
 */
import { Moon, Sun } from "@lucide/astro";
---

<button type="button" class="theme-toggle" data-theme-toggle>
  <span class="to-light">
    <Sun size={18} stroke-width={1.5} aria-hidden="true" />
    <span class="visually-hidden">Switch to light theme</span>
  </span>
  <span class="to-dark">
    <Moon size={18} stroke-width={1.5} aria-hidden="true" />
    <span class="visually-hidden">Switch to dark theme</span>
  </span>
</button>

<script>
  const root = document.documentElement;
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
    button.addEventListener("click", () => {
      const theme = root.dataset.theme === "light" ? "dark" : "light";
      root.dataset.theme = theme;
      try {
        localStorage.setItem("theme", theme);
      } catch {
        // Storage can be blocked; the theme still applies to this page.
      }
    });
  }
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--target-min);
    height: var(--target-min);
    padding: 0;
    border: 0;
  }

  .to-light,
  .to-dark {
    display: inline-flex;
  }

  .to-dark,
  :global([data-theme="light"]) .to-light {
    display: none;
  }

  :global([data-theme="light"]) .to-dark {
    display: inline-flex;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
