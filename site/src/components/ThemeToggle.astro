---
/**
 * Switches between the dark (default) and light themes. The choice is kept in
 * localStorage; BaseLayout applies it before the page paints, so there is no
 * flash. The button names the theme it switches to; CSS shows the right label
 * from data-theme, so it is correct before any script runs.
 */
---

<button type="button" class="theme-toggle" data-theme-toggle>
  <span class="to-light">
    <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
      <circle cx="7" cy="7" r="2.8" fill="none" stroke="currentColor" stroke-width="1.2"></circle>
      <path
        d="M7 .8v1.8M7 11.4v1.8M.8 7h1.8M11.4 7h1.8M2.6 2.6l1.3 1.3M10.1 10.1l1.3 1.3M2.6 11.4l1.3-1.3M10.1 3.9l1.3-1.3"
        stroke="currentColor"
        stroke-width="1.1"></path>
    </svg>
    Light
  </span>
  <span class="to-dark">
    <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
      <path d="M10 1.6a5.4 5.4 0 1 0 2.4 7.2A4.3 4.3 0 0 1 10 1.6z" fill="none" stroke="currentColor" stroke-width="1.2"
      ></path>
    </svg>
    Dark
  </span>
</button>

<script>
  const root = document.documentElement;
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
    button.addEventListener("click", () => {
      const theme = root.dataset.theme === "light" ? "dark" : "light";
      root.dataset.theme = theme;
      try {
        localStorage.setItem("theme", theme);
      } catch {
        // Storage can be blocked; the theme still applies to this page.
      }
    });
  }
</script>

<style>
  .theme-toggle {
    min-height: var(--target-min);
    padding: 0 var(--space-2);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-sm);
  }

  span {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .to-dark,
  :global([data-theme="light"]) .to-light {
    display: none;
  }

  :global([data-theme="light"]) .to-dark {
    display: inline-flex;
  }
</style>
