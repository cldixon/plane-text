---
/**
 * The tab bar under the masthead. Each tab is a link to its own page, so a
 * tab can be linked to and the back button works; the current one is marked
 * with aria-current. At its right end, the download of the latest release:
 * /download, which the Worker redirects to the release's zip in R2.
 */
import { Download, FileText, SquareTerminal } from "@lucide/astro";

const tabs = [
  { href: "/", label: "Overview", icon: FileText },
  { href: "/shell", label: "Shell", icon: SquareTerminal },
];

// Pages build as single files, so this is "/shell.html" at build time.
const path = Astro.url.pathname.replace(/(\/index)?(\.html)?\/?$/, "") || "/";
---

<nav aria-label="Views" class="tabs">
  {
    tabs.map(({ href, label, icon: Icon }) => (
      <a href={href} aria-current={path === href ? "page" : undefined}>
        <Icon size={16} stroke-width={1.75} aria-hidden="true" />
        {label}
      </a>
    ))
  }
  <!-- A full navigation, not the client router's: the response is a file to save. -->
  <a href="/download" class="download" download data-astro-reload title="Download the latest release: every processed dataset as parquet, zipped">
    <Download size={16} stroke-width={1.75} aria-hidden="true" />
    Download
  </a>
</nav>

<style>
  .tabs {
    display: flex;
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
    border-bottom: var(--border);
  }

  a,
  a:visited {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target-min);
    padding: 0 var(--space-3);
    margin-bottom: calc(-1 * var(--border-width));
    font-family: var(--font-family-label);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition: color var(--transition-fast);
  }

  a:hover {
    color: var(--color-text);
  }

  a[aria-current="page"] {
    color: var(--color-text);
    border-bottom-color: var(--color-text);
  }

  .download,
  .download:visited {
    margin-left: auto;
    color: var(--color-text);
  }
</style>
