---
/**
 * Downloads the latest release: /download, which the Worker redirects to the
 * release's zip in R2 (every processed dataset as parquet, with its README,
 * license and manifest).
 */
import { Download } from "@lucide/astro";
---

<a class="download" href="/download" download title="Download the latest release: every dataset as parquet, zipped">
  <Download size={16} stroke-width={1.75} aria-hidden="true" />
  Download
</a>

<style>
  .download,
  .download:visited {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.25rem;
    padding: 0 0.75rem;
    font-family: var(--font-family-label);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    border: var(--border-strong);
    border-radius: var(--radius);
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .download:hover,
  .download:focus-visible {
    color: var(--color-text);
    border-color: var(--color-text);
  }
</style>
