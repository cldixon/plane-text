---
/**
 * A two-part link badge: a muted key and its value, like the shields.io
 * badges on project READMEs, in the site's grays. Without an href it is drawn
 * dashed and marked "soon".
 */
import type { Badge } from "../site";

type Props = Badge;

const { key, value, href } = Astro.props;
---

{
  href ? (
    <a class="badge" href={href}>
      <span class="key">{key}</span>
      <span class="value">{value}</span>
    </a>
  ) : (
    <span class="badge soon">
      <span class="key">{key}</span>
      <span class="value">{value} · soon</span>
    </span>
  )
}

<style>
  .badge {
    display: inline-flex;
    font-family: var(--font-family-mono);
    font-size: var(--font-size-badge);
    line-height: 1;
    color: var(--color-text);
    text-decoration: none;
    border: var(--border-strong);
    border-radius: var(--radius);
    transition: border-color var(--transition-fast);
  }

  a.badge:visited {
    color: var(--color-text);
  }

  a.badge:hover {
    border-color: var(--color-text);
  }

  .key,
  .value {
    padding: 0.45rem 0.6rem;
  }

  .key {
    color: var(--color-text-muted);
    background: var(--color-hover);
  }

  .soon {
    border-style: dashed;
  }

  .soon .value {
    color: var(--color-text-muted);
  }
</style>
