---
import "@design/index.css";
import { ClientRouter } from "astro:transitions";
import ThemeToggle from "@components/ThemeToggle.astro";
import { site } from "../site";

interface Props {
  title?: string;
  description?: string;
  /** Use the wide measure, for pages built around tables. */
  wide?: boolean;
}

const { title = site.title, description = site.description, wide = false } = Astro.props;
// Pages build as single files ("/shell.html"); the canonical URL drops ".html".
const canonical = new URL(Astro.url.pathname.replace(/(\/index)?\.html$/, "") || "/", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <script is:inline>
      // Apply a saved light theme before the page paints; dark is the default.
      // The client router swaps <html> attributes on navigation, so apply it
      // again after every swap.
      (() => {
        const apply = (doc) => {
          try {
            if (localStorage.getItem("theme") === "light") doc.documentElement.dataset.theme = "light";
          } catch {}
        };
        apply(document);
        if (!window.__themeOnSwap) {
          window.__themeOnSwap = true;
          document.addEventListener("astro:before-swap", (event) => apply(event.newDocument));
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <header>
      <ThemeToggle />
    </header>
    <main class:list={{ wide }}>
      <slot />
    </main>
  </body>
</html>

<style>
  header {
    display: flex;
    justify-content: flex-end;
    padding: var(--space-3) var(--gutter);
  }

  main {
    max-width: var(--measure);
    margin: 0 auto;
    padding: var(--space-4) var(--gutter) var(--space-5);
  }

  main.wide {
    max-width: var(--measure-wide);
  }
</style>
