---
/**
 * The site's page: the masthead (title, tagline, a row of links, Download
 * first), the paper
 * below it, and the query console, a floating Query button that opens the
 * SQL shell over the page.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import { Download } from "@lucide/astro";
import QueryConsole from "@components/QueryConsole.svelte";
import { datasets, formatCount, shellPlaceholder, shellSample, shellTables } from "../corpus";
import { links, site } from "../site";

interface Props {
  /** The page title, after the site title. Omit on the home page. */
  title?: string;
}

const { title } = Astro.props;

const tables = shellTables.map((table) => {
  const dataset = datasets.find((d) => d.name === table.dataset);
  return { name: table.name, src: table.src, rows: dataset?.rows ? formatCount(dataset.rows) : "" };
});
const soon = datasets.map((d) => d.name).filter((name) => !shellTables.some((t) => t.dataset === name));
---

<BaseLayout title={title ? `${title} · ${site.title}` : site.title}>
  <div class="masthead">
    <h1><a href="/">{site.title}</a></h1>
    <p class="tagline">{site.tagline}</p>
    <nav aria-label="Project links">
      <ul>
        {
          links.map(({ label, href, download }) => (
            <li>
              {href ? (
                <a href={href} download={download || undefined} class:list={{ primary: download }}>
                  {download && <Download size={14} stroke-width={1.75} aria-hidden="true" />}
                  {label}
                </a>
              ) : (
                <span class="soon">{label} (soon)</span>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <slot />
  <QueryConsole client:load {tables} {soon} sample={shellSample} placeholder={shellPlaceholder} />
</BaseLayout>

<style>
  .masthead {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    text-align: center;
  }

  h1 {
    margin: 0;
    font-family: var(--font-family-mono);
    font-size: var(--font-size-display);
    font-weight: var(--font-weight-normal);
  }

  h1 a,
  h1 a:visited {
    color: inherit;
    text-decoration: none;
  }

  .tagline {
    margin: 0;
    font-size: var(--font-size-lg);
    color: var(--color-text-muted);
  }

  /* One quiet line of links, separated by middle dots. */
  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-1) 0;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-family-label);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  li + li::before {
    content: "·";
    margin: 0 0.6em;
  }

  /* Where the row may wrap, spacing instead of dots, so no line starts with one. */
  @media (max-width: 30rem) {
    ul {
      gap: var(--space-1) var(--space-4);
    }

    li + li::before {
      content: none;
    }
  }

  a,
  a:visited {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  a:hover,
  a:focus-visible,
  a.primary,
  a.primary:visited {
    color: var(--color-text);
  }

  a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .soon {
    opacity: 0.7;
  }
</style>
