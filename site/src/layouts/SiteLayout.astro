---
/**
 * The site's page: the masthead (title, tagline, link badges), the paper
 * below it, and the query console, a floating Query button that opens the
 * SQL shell over the page.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import Badge from "@components/Badge.astro";
import QueryConsole from "@components/QueryConsole.svelte";
import { datasets, formatCount, shellPlaceholder, shellSample, shellTables } from "../corpus";
import { badges, site } from "../site";

interface Props {
  /** The page title, after the site title. Omit on the home page. */
  title?: string;
}

const { title } = Astro.props;

const tables = shellTables.map((table) => {
  const dataset = datasets.find((d) => d.name === table.dataset);
  return { name: table.name, src: table.src, rows: dataset?.rows ? formatCount(dataset.rows) : "" };
});
const soon = datasets.map((d) => d.name).filter((name) => !shellTables.some((t) => t.dataset === name));
---

<BaseLayout title={title ? `${title} · ${site.title}` : site.title}>
  <div class="masthead">
    <h1><a href="/">{site.title}</a></h1>
    <p class="tagline">{site.tagline}</p>
    <nav aria-label="Project links">
      {badges.map((badge) => <Badge {...badge} />)}
    </nav>
  </div>
  <slot />
  <QueryConsole client:load {tables} {soon} sample={shellSample} placeholder={shellPlaceholder} />
</BaseLayout>

<style>
  .masthead {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    text-align: center;
  }

  h1 {
    margin: 0;
    font-family: var(--font-family-mono);
    font-size: var(--font-size-display);
    font-weight: var(--font-weight-normal);
  }

  h1 a,
  h1 a:visited {
    color: inherit;
    text-decoration: none;
  }

  .tagline {
    margin: 0;
    font-size: var(--font-size-lg);
    color: var(--color-text-muted);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
  }
</style>
