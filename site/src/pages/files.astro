---
/**
 * An index of the bucket's processed/ folder, in the style of a web server's
 * directory listing. Sizes and dates will come from R2 once the Worker can
 * list the bucket; until then they read "—", and folders are not links.
 */
import SiteLayout from "@layouts/SiteLayout.astro";
import { processedFolders, snapshot } from "../corpus";
---

<SiteLayout title="Files">
  <section aria-labelledby="index" class="files">
    <h2 id="index">Index of /processed/</h2>

    <div class="archive">
      <span>plane-text-v{snapshot}.zip</span>
      <span class="muted">the whole snapshot</span>
      <span class="muted soon">soon</span>
    </div>

    <div class="scroll">
      <table>
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col" class="modified">Last modified</th>
            <th scope="col" class="size">Size</th>
          </tr>
        </thead>
        <tbody>
          {
            processedFolders.map((folder) => (
              <tr>
                <td>{folder}/</td>
                <td class="muted">—</td>
                <td class="muted size">—</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
</SiteLayout>

<style>
  .files {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-sm);
  }

  h2 {
    margin: 0;
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-normal);
  }

  .archive {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    padding: 0.75rem 0.9rem;
    border: var(--border-width) dashed var(--color-border-strong);
    border-radius: var(--radius);
  }

  .soon {
    margin-left: auto;
  }

  .muted {
    color: var(--color-text-muted);
  }

  .scroll {
    overflow-x: auto;
  }

  table {
    width: 100%;
    min-width: 30rem;
    border-collapse: collapse;
  }

  th,
  td {
    padding: 0.45rem 0.6rem;
    text-align: left;
    border-bottom: var(--border);
  }

  th {
    font-weight: var(--font-weight-normal);
    color: var(--color-text-muted);
    border-bottom: var(--border-strong);
  }

  tbody tr:hover {
    background: var(--color-hover);
  }

  .modified {
    width: 10rem;
  }

  .size {
    width: 5rem;
    text-align: right;
  }
</style>
