---
import BaseLayout from "@layouts/BaseLayout.astro";
import Badge from "@components/Badge.astro";
import SqlViewer from "@components/SqlViewer.svelte";
import { badges, site } from "../site";

/** Served from the private R2 bucket by the Worker in site/cloudflare/src. */
const src = "/data/processed/faa-ads/v2026-10-23/ad-final-rules.parquet";

const initialQuery = `SELECT ad_number, effective_date, status, make, subject
FROM ads
ORDER BY effective_date DESC
LIMIT 100`;

const examples = [
  { label: "Latest ADs", query: initialQuery },
  {
    label: "ADs per year",
    query: `SELECT year(effective_date) AS year, count(*) AS ads
FROM ads
WHERE effective_date IS NOT NULL
GROUP BY year
ORDER BY year DESC`,
  },
  {
    label: "Most-cited manufacturers",
    query: `SELECT manufacturer, count(*) AS ads
FROM (SELECT unnest(make) AS manufacturer FROM ads)
GROUP BY manufacturer
ORDER BY ads DESC
LIMIT 25`,
  },
  {
    label: "Search subjects",
    query: `SELECT ad_number, effective_date, make, subject
FROM ads
WHERE subject ILIKE '%landing gear%'
ORDER BY effective_date DESC
LIMIT 100`,
  },
  { label: "Columns", query: "DESCRIBE ads" },
];
---

<BaseLayout>
  <header class="masthead">
    <h1>{site.title}</h1>
    <p class="tagline">{site.tagline}</p>
    <nav aria-label="Project links">
      {badges.map((badge) => <Badge {...badge} />)}
    </nav>
  </header>

  <section aria-labelledby="abstract">
    <h2 id="abstract">Abstract</h2>
    <p>
      Aircraft maintenance runs on text: the regulations that govern it, the airworthiness directives that order
      inspections and repairs, the bulletins and advisory circulars that explain them, and the reports mechanics and
      investigators write when something goes wrong. Airlines hold large internal collections of this kind of text, but
      little of it is available for open research.
    </p>
    <p>
      Plane-text gathers the public side of it from the FAA, the eCFR and the NTSB, cleans it, and publishes it as
      versioned datasets: the same kinds of documents a maintenance organization works with, ready for search,
      analysis and language models.
    </p>
  </section>

  <section aria-labelledby="explore">
    <h2 id="explore">Explore</h2>
    <p>
      Query the FAA airworthiness directives with SQL, in your browser. The table is <code>ads</code>, one row per
      directive.
    </p>
    <SqlViewer client:only="svelte" {src} view="ads" {initialQuery} {examples} />
  </section>
</BaseLayout>

<style>
  /* Laid out like a project README: a centered masthead (title, tagline,
     link badges), then left-aligned sections in one column. */
  .masthead {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
    text-align: center;
  }

  h1 {
    margin: 0;
    font-family: var(--font-family-mono);
    font-size: var(--font-size-display);
    font-weight: var(--font-weight-normal);
  }

  .tagline {
    margin: 0;
    font-size: var(--font-size-lg);
    color: var(--color-text-muted);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
  }

  section + section {
    margin-top: var(--space-5);
  }

  h2 {
    margin: 0 0 var(--space-3);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-h2);
    font-weight: var(--font-weight-normal);
  }

  section > p:last-of-type {
    margin-bottom: var(--space-4);
  }
</style>
