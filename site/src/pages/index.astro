---
import SiteLayout from "@layouts/SiteLayout.astro";
import BarChart, { type Bar } from "@components/BarChart.astro";
import DataPlate from "@components/DataPlate.astro";
import { datasets, formatCount } from "../corpus";

// Records per dataset, on a log scale from 100 to 2 million: the service
// difficulty reports would otherwise flatten every other bar.
const [logMin, logMax] = [2, Math.log10(2e6)];
const logAt = (n: number) => (Math.log10(n) - logMin) / (logMax - logMin);
const recordBars: Bar[] = datasets
  .filter((d) => d.rows !== null)
  .sort((a, b) => (b.rows ?? 0) - (a.rows ?? 0))
  .map((d) => ({ label: d.name, from: 0, to: logAt(d.rows ?? 1), value: formatCount(d.rows ?? 0, d.approximate) }));
const recordTicks = [
  { at: logAt(100), label: "100" },
  { at: logAt(1e4), label: "10k" },
  { at: logAt(1e6), label: "1M" },
];

// Years covered, for the datasets whose span is known.
const [yearMin, yearMax] = [1940, 2030];
const yearAt = (y: number) => (y - yearMin) / (yearMax - yearMin);
const spanBars: Bar[] = datasets
  .flatMap((d) => (d.span ? [{ name: d.name, span: d.span }] : []))
  .sort((a, b) => a.span[0] - b.span[0])
  .map(({ name, span }) => ({ label: name, from: yearAt(span[0]), to: yearAt(span[1]), value: span.join("–") }));
const yearTicks = [1940, 1980, 2020].map((y) => ({ at: yearAt(y), label: String(y) }));
---

<SiteLayout>
  <section aria-labelledby="abstract">
    <h2 id="abstract">Abstract</h2>
    <p>
      Aircraft maintenance runs on text: the regulations that govern it, the airworthiness directives that order
      inspections and repairs, the bulletins and advisory circulars that explain them, and the reports mechanics and
      investigators write when something goes wrong. Airlines hold large internal collections of this kind of text, but
      little of it is available for open research.
    </p>
    <p>
      Plane-text gathers the public side of it from the FAA, the eCFR and the NTSB, cleans it, and publishes it as
      versioned datasets: the same kinds of documents a maintenance organization works with, ready for search,
      analysis and language models.
    </p>
  </section>

  <section aria-labelledby="corpus" class="corpus">
    <h2 id="corpus">The corpus</h2>
    <DataPlate />
    <BarChart caption="Records per dataset" note="log scale" bars={recordBars} ticks={recordTicks} />
    <BarChart caption="Coverage by year" bars={spanBars} ticks={yearTicks} />
  </section>
</SiteLayout>

<style>
  section + section {
    margin-top: var(--space-5);
  }

  h2 {
    margin: 0 0 var(--space-3);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-h2);
    font-weight: var(--font-weight-normal);
  }

  .corpus {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .corpus h2 {
    margin: 0;
  }
</style>
