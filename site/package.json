{
  "name": "plane-text-site",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bunx --bun astro dev",
    "check": "bunx --bun astro check",
    "build": "bunx --bun astro check && bunx --bun astro build",
    "preview": "bunx wrangler dev",
    "deploy": "bun run build && bunx wrangler deploy"
  },
  "dependencies": {
    "@astrojs/svelte": "^9.1.1",
    "astro": "^7.4.2",
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^6.0.3",
    "wrangler": "^4.152.0"
  }
}
